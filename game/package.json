{
  "name": "no-way-down-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run audit:campaign && npm run audit:protected-assets && npm run audit:generated-production-art && npm run audit:character-hud-production && npm run audit:tiled && tsc --noEmit && vite build && node scripts/auditDistProductionArt.mjs",
    "test:e2e:production": "bash scripts/runProductionE2E.sh",
    "audit:campaign": "node scripts/auditCanonicalCampaign.mjs",
    "audit:protected-assets": "node scripts/auditProtectedAssets.mjs",
    "audit:tiled": "node scripts/auditTiledMaps.mjs",
    "audit:runtime-reachability": "node scripts/auditRuntimeReachability.mjs",
    "audit:dead-code": "node scripts/auditDeadRuntimeCode.mjs",
    "audit:no-binary-diff": "node scripts/auditNoBinaryDiff.mjs",
    "audit:character-hud-production": "node scripts/auditCharacterAndHudProduction.mjs",
    "audit:e2e-text-only": "node scripts/auditTextOnlyE2E.mjs",
    "audit:visual-production": "node scripts/auditVisualProduction.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "audit:midgame-progression": "node scripts/auditMidgameProgression.mjs",
    "audit:real-backdrops": "node scripts/auditRealBackdrops.mjs",
    "generate:runtime-art": "python3 scripts/art/generateProductionCharacters.py",
    "verify:runtime-art": "python3 scripts/art/generateProductionCharacters.py --verify",
    "clean:generated-art": "node scripts/cleanGeneratedArt.mjs",
    "audit:generated-production-art": "node scripts/auditGeneratedProductionArt.mjs",
    "audit:dist-production-art": "node scripts/auditDistProductionArt.mjs",
    "predev": "npm run generate:runtime-art",
    "prebuild": "npm run generate:runtime-art",
    "postbuild": "npm run clean:generated-art",
    "audit:production-art-v2": "node scripts/auditProductionArtV2.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
