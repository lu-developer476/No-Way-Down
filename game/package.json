{
  "name": "no-way-down-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/auditCanonicalCampaign.mjs && tsc --noEmit && vite build && node scripts/verifyBuildCampaignFlow.mjs",
    "audit:campaign": "node scripts/auditCanonicalCampaign.mjs",
    "preview": "vite preview",
    "generate:institutional-tileset": "node scripts/generateInstitutionalTileset.mjs",
    "generate:bank-counter-spritesheet": "node scripts/generateBankCounterSpritesheet.mjs",
    "generate:dining-tables-spritesheet": "node scripts/generateDiningTablesSpritesheet.mjs",
    "generate:stone-columns-spritesheet": "node scripts/generateStoneColumnsSpritesheet.mjs",
    "generate:tall-windows-spritesheet": "node scripts/generateInstitutionalTallWindowsSpritesheet.mjs",
    "generate:institutional-decor-spritesheet": "node scripts/generateInstitutionalDecorSpritesheet.mjs",
    "generate:stairs-spritesheet": "node scripts/generateInstitutionalStairsSpritesheet.mjs",
    "generate:zombie-damage-tilesheet": "node scripts/generateZombieDamageTileset.mjs",
    "audit:asset-routes": "node scripts/auditAssetRoutes.mjs",
    "fix:asset-routes": "node scripts/auditAssetRoutes.mjs --fix",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e:production": "bash scripts/runProductionE2E.sh",
    "test:e2e:update-visuals": "UPDATE_VISUALS=1 bash scripts/runProductionE2E.sh"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
